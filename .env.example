# --- DATABASE ---
# Local development (SQLite — default schema.prisma):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL — schema.postgres.prisma).
# Use Vercel Postgres / Neon / Supabase / Railway.
# Example: postgresql://user:password@host:5432/dbname?schema=public
# DATABASE_URL="postgresql://user:password@host:5432/ingatwaktu?schema=public"

# --- NEXT-AUTH ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Local: http://localhost:3000
# Production (Vercel): leave EMPTY or set to your deployment URL.
# Vercel injects the `VERCEL_URL` automatically via NEXTAUTH_URL fallback.
NEXTAUTH_URL="http://localhost:3000"